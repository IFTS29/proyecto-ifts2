# Copiar como .env y completar. El archivo .env no se sube al repositorio.
PORT=4000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/ifts2
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Instagram (Graph API): el token vive unos 60 días y se renueva con la tarea programada
INSTAGRAM_TOKEN=
INSTAGRAM_HASHTAG=IFTSEventos
# Correo de Bedelía y servicio de envío
CORREO_BEDELIA=

# Primer administrador (se crea solo si no hay usuarios). En producción son obligatorias.
SEED_ADMIN_NOMBRE=
SEED_ADMIN_MAIL=
SEED_ADMIN_PASSWORD=
