PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
# Dirección pública del sitio, para el enlace a Contacto de los PDF. En local puede quedar vacía.
# En Vercel conviene cargarla en Production: https://proyecto-ifts2.vercel.app
SITIO_URL=
MONGODB_URI=
JWT_SECRET=clave-solo-para-desarrollo
JWT_DURACION=8h
BCRYPT_COSTO=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
INSTAGRAM_TOKEN=
INSTAGRAM_HASHTAG=IFTSEventos
# Formulario de contacto: casillas que reciben las consultas (tienen que ser distintas).
# Para probar, usá casillas propias; nunca las reales del IFTS.
CORREO_BEDELIA=
CORREO_INSTITUCIONAL=
# Cuenta que envía los correos del formulario. Con Gmail: activar la verificación en dos pasos y
# crear una contraseña de aplicación (no sirve la contraseña normal). Sin usuario ni clave, en
# desarrollo se usa el envío simulado; con uno solo, el envío falla. Nunca subir estos datos al repo.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=465
SMTP_USUARIO=
SMTP_CLAVE=
SEED_ADMIN_NOMBRE=Matías Peláez
SEED_ADMIN_MAIL=matias.pelaez@ifts2.edu.ar
SEED_ADMIN_PASSWORD=Cambiar1234
GEMINI_API_KEY=
