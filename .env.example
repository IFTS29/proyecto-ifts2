# ==============================================================================
# CONFIGURACIÓN PARA DESARROLLO LOCAL (Valores listos para copiar y ejecutar)
# ==============================================================================
# Copiá este archivo como .env (cp .env.example .env o Copy-Item en PowerShell)
# y ejecutá `npm run dev`. Con estos valores el servidor arranca en http://localhost:3000
# con datos en memoria y podés ingresar al panel en /login con las credenciales abajo:

PORT=3000
JWT_SECRET=secreto-desarrollo-ifts2-2026
JWT_DURACION=8h
BCRYPT_COSTO=10

# Administrador inicial para desarrollo local (se crea solo si la base está vacía)
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_MAIL=admin@ifts2.edu.ar
SEED_ADMIN_PASSWORD=Admin1234!

# Direcciones del sitio y cliente
SITIO_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000

# ==============================================================================
# BASE DE DATOS MONGODB ATLAS (Opcional en desarrollo local, obligatoria en producción)
# ==============================================================================
# Si está vacía en desarrollo local, el servidor funciona en memoria (los datos se
# reinician al detenerlo). Si se completa, persiste en el clúster de Atlas.
MONGODB_URI=

# ==============================================================================
# ALMACENAMIENTO DE FOTOS Y MULTIMEDIA (Cloudinary)
# ==============================================================================
# En desarrollo local sin Cloudinary, las fotos se guardan en almacenamiento local.
# En producción y en Vercel son requeridas para la carga y persistencia de fotos de eventos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==============================================================================
# INTEGRACIÓN CON INSTAGRAM GRAPH API
# ==============================================================================
# Si faltan credenciales, la sincronización queda deshabilitada en el panel y los
# eventos se cargan manualmente sin errores. El token dura 60 días y se renueva
# manualmente actualizando INSTAGRAM_TOKEN (sin tareas programadas automáticas).
INSTAGRAM_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_HASHTAG=eventosIFTS2

# ==============================================================================
# SERVICIO DE CORREO SMTP (Formulario de Contacto)
# ==============================================================================
# En desarrollo local sin credenciales, el envío de correos se simula en consola sin fallar.
# En producción deben configurarse casillas válidas y credenciales SMTP reales.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=465
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_BEDELIA=
CORREO_INSTITUCIONAL=
